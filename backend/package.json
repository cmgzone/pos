{
  "name": "piki-pos-sync-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + PostgreSQL sync backend for Piki POS",
  "main": "src/server.js",
  "scripts": {
    "db:check": "node src/checkDb.js",
    "db:init": "node src/initDb.js",
    "db:migrate:postgres": "node src/migratePostgres.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-isolation=none"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3"
  }
}
