PORT=3000
NODE_ENV=development

# Use the pooled connection string from your Neon project.
# The backend accepts NEON_DATABASE_URL, DATABASE_URL, or POSTGRES_URL.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-ENDPOINT/piki_pos?sslmode=require

SUBSCRIPTION_TRIAL_DAYS=30
SUBSCRIPTION_GRACE_DAYS=5

# Keep this in sync with the Flutter build via:
# --dart-define=LICENSE_SIGNING_SECRET=your-secret
LICENSE_SIGNING_SECRET=replace-with-a-long-random-secret

PLATFORM_ADMIN_EMAIL=admin@your-domain.example
PLATFORM_ADMIN_PASSWORD=change-me
PLATFORM_JWT_SECRET=replace-with-a-long-random-jwt-secret

# Required in production for browser clients such as the admin panel.
PLATFORM_ALLOWED_ORIGINS=https://admin.your-domain.example,https://shop.your-domain.example

# Optional but recommended. Add ?secret=<value> to the configured M-Pesa callback URL.
MPESA_CALLBACK_SECRET=replace-with-a-long-random-callback-secret

# Public HTTPS base URL after deployment, for example:
# MPESA_CALLBACK_URL=https://api.your-domain.example/api/subscription/mpesa/callback?secret=replace-with-a-long-random-callback-secret
# Manual C2B Till/Paybill callback URLs to register with Safaricom:
# https://api.your-domain.example/api/payments/mpesa/c2b-validation?secret=replace-with-a-long-random-callback-secret
# https://api.your-domain.example/api/payments/mpesa/c2b-confirmation?secret=replace-with-a-long-random-callback-secret

# Optional: enables Piki web search through the backend SerpAPI proxy.
SERPAPI_API_KEY=your-serpapi-key
